<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkslategray"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="25dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textViewTipsy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/black"
        android:text="@string/tipsy"
        android:textAlignment="center"
        android:textColor="@color/crimsonRed"
        android:textSize="65dp" />

    <TextView
        android:id="@+id/textViewEnterBillAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewTipsy"
        android:layout_marginBottom="32dp"
        android:text="@string/enter_bill_amount"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="22dp" />

    <EditText
        android:id="@+id/editTextBillAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewEnterBillAmount"
        android:layout_marginBottom="60dp"
        android:hint="@string/bill_amount"
        android:inputType="numberDecimal"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textViewChooseTipAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/editTextBillAmount"
        android:layout_marginBottom="20dp"
        android:text="@string/choose_tip_amount"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="22dp" />

    <LinearLayout
        android:id="@+id/linearVerticalGroup1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewChooseTipAmount"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="20dp">

        <Button
            android:id="@+id/buttonMinus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:backgroundTint="@color/mediumseagreen"
            android:text="@string/minus"
            android:textAlignment="center"
            android:textSize="50dp" />

        <TextView
            android:id="@+id/textViewTipPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:text="0%"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="35dp" />

        <Button
            android:id="@+id/buttonPlus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:backgroundTint="@color/mediumseagreen"
            android:text="@string/plus"
            android:textSize="50dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/textViewTotalKr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_below="@+id/linearVerticalGroup1"
        android:text="0.00 kr"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="50dp" />

    <TextView
        android:id="@+id/textViewSumTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textViewTotalKr"
        android:layout_marginBottom="20dp"
        android:text="@string/total"
        android:textAlignment="center"
        android:textColor="@color/crimsonRed"
        android:textSize="40dp" />

    <LinearLayout
        android:id="@+id/linearVerticalGroup2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textViewSumTotal"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/linearHorizontalGroupLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/textViewBillKr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="0.00 kr"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/textViewBillText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textViewBillKr"
                android:layout_marginBottom="40dp"
                android:text="@string/bill"
                android:textAlignment="center"
                android:textColor="@color/crimsonRed"
                android:textSize="25dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearHorizontalGroupRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/textViewTipKr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="0.00 kr"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/textViewTipText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textViewTipKr"
                android:layout_marginBottom="40dp"
                android:text="@string/tip"
                android:textAlignment="center"
                android:textColor="@color/crimsonRed"
                android:textSize="25dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>

