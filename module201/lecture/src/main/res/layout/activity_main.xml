<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Black_Pearl"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="117dp"
        android:backgroundTint="@color/white"
        android:contentDescription="@string/the_app_logo_x_changer"
        android:src="@drawable/exchange_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="@string/x_changer"
        android:textColor="@color/white"
        android:textSize="30dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:text="@string/find_the_best_cash_n_exchange_rates"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="27dp" />

    <Button
        android:id="@+id/buttonContinue"
        android:layout_width="281dp"
        android:layout_height="40dp"
        android:layout_marginTop="82dp"
        android:layout_marginBottom="116dp"
        android:backgroundTint="@color/darkorange"
        android:text="@string/continue_" />

</LinearLayout>