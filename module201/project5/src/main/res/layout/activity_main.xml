<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkslategrey"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="35dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/age_calculator"
        android:textColor="@color/darkorange"
        android:textSize="40sp" />

    <EditText
        android:id="@+id/editTextYearOfBirth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:backgroundTint="@color/grayly"
        android:hint="@string/year_of_birth"
        android:inputType="number"
        android:textColor="@color/white"
        android:textColorHint="@color/grayly"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editTextMonthOfBirth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:backgroundTint="@color/grayly"
        android:hint="@string/month_of_birth"
        android:inputType="number"
        android:textColor="@color/white"
        android:textColorHint="@color/grayly"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editTextDayOfBirth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:backgroundTint="@color/grayly"
        android:hint="@string/day_of_birth"
        android:inputType="number"
        android:textColor="@color/white"
        android:textColorHint="@color/grayly"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/your_age_in"
        android:textColor="@color/white"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/textViewYearsOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="40sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/years"
        android:textColor="@color/darkorange"
        android:textSize="15sp" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="19sp"
        android:backgroundTint="@color/grayly" />

    <TextView
        android:id="@+id/textViewMonthsOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="40sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/months"
        android:textColor="@color/darkorange"
        android:textSize="15sp" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="19sp"
        android:backgroundTint="@color/grayly" />

    <TextView
        android:id="@+id/textViewWeeksOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="40sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/weeks"
        android:textColor="@color/darkorange"
        android:textSize="15sp" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="19sp"
        android:backgroundTint="@color/grayly" />

    <TextView
        android:id="@+id/textViewDaysOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="40sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/days"
        android:textColor="@color/darkorange"
        android:textSize="15sp" />

</LinearLayout>