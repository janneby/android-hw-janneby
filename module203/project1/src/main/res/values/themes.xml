<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AndroidHomework" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/mediumvioletred</item>
        <item name="android:actionMenuTextColor">@color/mediumvioletred</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Apptheme.Toolbar" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textSize">20dp</item>
        <item name="android:background">@color/white</item>
        <item name="titleTextColor">@color/black</item>
        <item name="android:textColor">@color/black</item>
        <item name="tint">@color/black</item>
        <item name="android:tint">@color/black</item>
    </style>

    <style name="Item.BottomNavigationView" parent="Widget.Design.BottomNavigationView">
        <item name="fontFamily">@font/montserrat</item>
    </style>

</resources>