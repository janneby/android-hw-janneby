<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AndroidHomework" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/greeny_thing</item>
        <item name="colorPrimaryVariant">@color/greeny_thing</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:actionMenuTextColor">@color/greeny_thing</item>

    </style>

    <style name="Theme.AndroidHomework" parent="Base.Theme.AndroidHomework" />

    <style name="Apptheme.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textSize">25sp</item>
    </style>

    <style name="Item.BottomNavigationView" parent="Widget.Design.BottomNavigationView">
        <item name="fontFamily">@font/montserrat</item>
    </style>

</resources>