<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/toursFragment">

    <fragment
        android:id="@+id/toursFragment"
        android:name="se.linerotech.module203.guide.tours.ToursFragment"
        android:label="@string/tours"
        tools:layout="@layout/fragment_tours">
        <action
            android:id="@+id/tourDetailsAction"
            app:destination="@id/tourDetailsFragment">
            <argument
                android:name="tour"
                app:argType="se.linerotech.module203.guide.tours.Tour" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/flightsFragment"
        android:name="se.linerotech.module203.guide.flights.FlightsFragment"
        android:label="@string/flights"
        tools:layout="@layout/fragment_flights" />

    <fragment
        android:id="@+id/carsFragment"
        android:name="se.linerotech.module203.guide.cars.CarsFragment"
        android:label="@string/cars"
        tools:layout="@layout/fragment_cars">
        <action
            android:id="@+id/carDetailsAction"
            app:destination="@id/carDetailsFragment">
            <argument
                android:name="car"
                app:argType="se.linerotech.module203.guide.cars.Car" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/hotelsFragment"
        android:name="se.linerotech.module203.guide.hotels.HotelsFragment"
        android:label="@string/hotels"
        tools:layout="@layout/fragment_hotels">
        <action
            android:id="@+id/hotelDetailsAction"
            app:destination="@id/hotelDetailsFragment">
            <argument
                android:name="hotel"
                app:argType="se.linerotech.module203.guide.hotels.Hotel" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/tourDetailsFragment"
        android:name="se.linerotech.module203.guide.tours.TourDetailsFragment"
        android:label="@string/tour_details"
        tools:layout="@layout/fragment_tour_details">
        <argument
            android:name="tour"
            app:argType="se.linerotech.module203.guide.tours.Tour" />
    </fragment>

    <fragment
        android:id="@+id/carDetailsFragment"
        android:name="se.linerotech.module203.guide.cars.CarDetailsFragment"
        android:label="Car Details"
        tools:layout="@layout/fragment_car_details">
        <argument
            android:name="car"
            app:argType="se.linerotech.module203.guide.cars.Car" />
    </fragment>

    <fragment
        android:id="@+id/hotelDetailsFragment"
        android:name="se.linerotech.module203.guide.hotels.HotelDetailsFragment"
        android:label="Hotel Details"
        tools:layout="@layout/fragment_hotel_details">
        <argument
            android:name="hotel"
            app:argType="se.linerotech.module203.guide.hotels.Hotel" />
    </fragment>

</navigation>